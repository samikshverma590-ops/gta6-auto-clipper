# ==============================================================================
# GTA 6 Auto-Clipper Environment Variables (Zero-Cost / Cloud-Only)
# Store live values in GitHub Repository Secrets — NEVER commit a filled .env!
# ==============================================================================

# --- AI Moment Scoring (Pick ONE free tier) ---
# Free Google AI Studio key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional free local/self-hosted OpenAI-compatible LLM (e.g. Ollama / Groq free tier)
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=llama-3.3-70b-versatile

# --- Optional Clipping Engines / MCPs ---
# OpenShorts hosted MCP or self-hosted URL (MIT self-hosted Docker needs no key)
OPENSHORTS_MCP_URL=https://mcp.openshorts.app/mcp
OPENSHORTS_API_KEY=
# GTAClipper self-hosted MCP endpoint (inside GitHub Actions service/container)
GTACLIPPER_MCP_URL=http://127.0.0.1:3107/mcp

# --- Social Publishing (Pick any active $0 option) ---
# Option A: Self-hosted TryPost / Postiz / Postbase MCP or REST
TRYPOST_API_URL=
TRYPOST_API_KEY=
POSTIZ_API_URL=
POSTIZ_API_KEY=
# Option B: Upload-Post free plan (used natively by OpenShorts)
UPLOAD_POST_API_KEY=
UPLOAD_POST_PROFILE=gta6clips
# Option C: Direct YouTube Data API v3 OAuth (100% free quota)
YOUTUBE_CLIENT_SECRETS_JSON=
YOUTUBE_REFRESH_TOKEN=
# Option D: TikTok / Instagram session (optional)
TIKTOK_SESSION_ID=
IG_ACCESS_TOKEN=
IG_USER_ID=

# --- Runtime Controls (ephemeral cloud /tmp only) ---
CLIP_WORK_DIR=/tmp/clip_work
DRY_RUN=true
MIN_VIRAL_SCORE=85
STAGGER_HOURS=3.5
